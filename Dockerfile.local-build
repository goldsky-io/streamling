# Local dev loop: build the streamling engine binary inside Docker (so a
# Linux binary comes out of a macOS host) and package it the same way as the
# release Dockerfile. Companion to streamling-goldsky-plugins'
# Dockerfile.plugin-build.
#
#   cd streamling
#   DOCKER_BUILDKIT=1 docker build -f Dockerfile.local-build \
#     -t goldsky-dev/streamling:local .
#   kind load docker-image goldsky-dev/streamling:local --name foundry-dev
FROM rust:1.90-bookworm AS builder

RUN apt-get update && apt-get install -y \
    pkg-config libssl-dev cmake g++ libclang-dev

WORKDIR /workspace/streamling
COPY . .

RUN cargo build --release --bin streamling

FROM gcr.io/distroless/cc:latest

COPY --from=builder /workspace/streamling/target/release/streamling /usr/local/bin/streamling

WORKDIR /opt/streamling

USER 65532:65532

ENTRYPOINT ["/usr/local/bin/streamling"]
